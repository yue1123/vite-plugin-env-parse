{
  "name": "vite-plugin-env-parse",
  "version": "1.0.15",
  "description": "Parse env string values to correct values, not all values are strings. And automatically generate ImportMetaEnv",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "module": "dist/index.mjs",
  "scripts": {
    "dev": "pnpm clean && tsup src/index.ts  --watch --dts --format esm",
    "build": "pnpm clean && tsup src/index.ts --dts --env.NODE_ENV production --format esm && pnpm clean-up",
    "clean": "rimraf dist",
    "test": "vitest",
    "clean-up": "rimraf tsconfig.tsbuildinfo",
    "example:dev": "pnpm run -C example dev",
    "example:build": "pnpm run -C example build",
    "example:preview": "pnpm run -C example preview"
  },
  "files": [
    "screenshots",
    "dist"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "plugin",
    "env",
    "env-parse",
    "string convert",
    "typecast",
    "dotEnv",
    "import"
  ],
  "author": "dh <2572458699@qq.com>",
  "homepage": "https://github.com/yue1123/vite-plugin-env-parse/#readme",
  "bugs": "https://github.com/yue1123/vite-plugin-env-parse/issues",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.3",
    "@types/node": "^18.15.0",
    "@vitest/coverage-v8": "^3.1.3",
    "magic-string": "^0.30.17",
    "memfs": "^4.17.1",
    "prettier": "^2.8.7",
    "rimraf": "^4.4.0",
    "tsup": "^8.0.1",
    "typescript": "^5.8.3",
    "vite": "6.3.4",
    "vitest": "^3.1.2"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "dependencies": {
    "@ark/json-schema": "^0.0.3",
    "arktype": "^2.1.20",
    "json-schema-to-ts": "^3.1.1",
    "json-schema-to-typescript-lite": "^14.1.0"
  }
}
